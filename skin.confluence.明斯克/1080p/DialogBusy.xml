<?xml version="1.0" encoding="UTF-8"?>
<window>
	<animation effect="fade" time="75">WindowOpen</animation>
	<animation effect="fade" time="150">WindowClose</animation>
	<coordinates>
		<left>0</left>
		<top>0</top>
	</coordinates>
	<controls>
	    <include>PosterWrapView</include>
		<control type="group">
		<visible>!VideoPlayer.Content(livetv)</visible>    <!--visible>!Player.Playing + !Player.Seeking + !Player.Paused + !Player.Forwarding + !Player.Rewinding</visible-->
			<depth>DepthDialog+</depth>
			<left>1280</left>
			<top>830</top>
			<control type="image">
				<description>Busy animation</description>
				<left>30</left>
				<top>26</top>
				<width>55</width>
				<height>55</height>
				<texture>busy.png</texture>
				<aspectratio>keep</aspectratio>
				<animation effect="rotate" start="0" end="360" center="auto" time="900" loop="true" condition="true">conditional</animation>
			</control>
			<control type="label">
				<description>Busy label</description>
				<left>100</left>
				<top>30</top>
				<width>auto</width>
				<height>48</height>
				<align>left</align>
				<aligny>center</aligny>
				<label>加载中，请您稍候。。。</label>
				<font>font13</font>
			</control>
			<control type="progress" id="10">
				<description>Progressbar</description>
				<left>30</left>
				<top>100</top>
				<width>400</width>
				<height>12</height>
				<texturebg border="4,5,4,5">ProgressBack.png</texturebg>
				<midtexture border="4,5,4,5">ProgressMid.png</midtexture>
			</control>
		</control>
		
	</controls>
</window>
