<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addons>
<addon id="skin.confluence.minsk" version="2025.8.3.a" name="Confluence-明斯克" provider-name="Minsk, CE使用交流群">
	<requires>
		<import addon="xbmc.gui" version="5.17.0"/>
	</requires>
	<extension point="xbmc.gui.skin" debugging="false" effectslowdown="1.0">
		<res width="1920" height="1080" aspect="16:9" default="true" folder="1080p" />
	</extension>
	<extension point="xbmc.addon.metadata">
		<platform>all</platform>
		<license>GNU General Public License version 2</license>
		<forum>https://forum.kodi.tv/forumdisplay.php?fid=125</forum>
		<source>https://github.com/xbmc/skin.confluence</source>
		<assets>
			<icon>resources/icon.png</icon>
			<fanart>resources/fanart.jpg</fanart>
			<screenshot>resources/screenshot-01.jpg</screenshot>
			<screenshot>resources/screenshot-02.jpg</screenshot>
			<screenshot>resources/screenshot-03.jpg</screenshot>
			<screenshot>resources/screenshot-04.jpg</screenshot>
			<screenshot>resources/screenshot-05.jpg</screenshot>
		</assets>
		<news>Omega update.</news>
		<summary lang="zh_CN">明斯克改进的 Confluence 皮肤。</summary>
		<summary lang="zh_TW">明斯克改进的面板 (Kodi 的預設面板)。</summary>
		<description lang="zh_CN">本皮肤由CE交流群-明斯克基于Confluence皮肤深度优化打造，在保持流畅运行的前提下融合了多款流行皮肤的精华功能，并加入多项创新设计，致力于为CE爱好者提供极致的视觉体验与操作便利。
主要功能集成了地平线风格海报墙，三行八列海报展示，光盘入盒滚动动画(可设置关闭)，剧集列表，播放页面可选剧集(书签)，播放页面加载剧情详情页和演员列表详情页，快捷选择字幕和音轨以及各种美化，更多细节欢迎各位喜爱KODI和CE的朋友深入体验。</description>
		
	</extension>
</addon>
